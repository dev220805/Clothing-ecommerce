# Required
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/atlas-commerce
JWT_ACCESS_SECRET=change-me-min-32-chars-access-secret-key
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-secret-key

# Production — your FRONTEND URL (not the API URL)
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app

# Optional: preview deployments (comma-separated)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend-git-main-user.vercel.app

# Optional: force cross-origin cookies (auto-detected when CLIENT_URL host ≠ API host)
# CROSS_ORIGIN_AUTH=true

# Optional
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Atlas Commerce <noreply@example.com>
